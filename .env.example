# Copy to .env.local (never commit it) to use MongoDB in development.
# Without MONGODB_URI, rooms are saved as JSON files in .data/.
MONGODB_URI=
MONGODB_DB=

# Push notifications. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, as mailto:you@example.com or your site address (optional)
VAPID_SUBJECT=
